# ─────────────────────────────────────────────────────────────────────────────
# Required — bot cannot start without these
# ─────────────────────────────────────────────────────────────────────────────

BOT_TOKEN=your_bot_token_here

FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Paste the entire service account JSON as ONE LINE (no newlines inside the value)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT",...}

# Alternative: path to the JSON file (use ONE method, not both)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# ─────────────────────────────────────────────────────────────────────────────
# Sightengine — AI image/video moderation (optional but strongly recommended)
#
# Without credentials, MEDIA_FALLBACK_POLICY determines what happens.
# Sign up (free tier): https://sightengine.com
#
# Endpoints used (verified against official docs 2026-10-23):
#   Image/GIF: POST https://api.sightengine.com/1.0/check.json
#   Video:     POST https://api.sightengine.com/1.0/video/check-sync.json
#              (sync endpoint, videos < 60 s; all account tiers)
# ─────────────────────────────────────────────────────────────────────────────

SIGHTENGINE_API_USER=your_api_user
SIGHTENGINE_API_SECRET=your_api_secret
SIGHTENGINE_IMAGE_MODELS=nudity-2.1,offensive,gore
SIGHTENGINE_NUDITY_THRESHOLD=0.80
SIGHTENGINE_OFFENSIVE_THRESHOLD=0.85

# ─────────────────────────────────────────────────────────────────────────────
# Media fallback policy — what to do when AI inspection is unavailable or fails
#
#   block  (DEFAULT, Strict Mode) — delete + warn user
#   allow  (permissive)           — let media through unmoderated
#   notify                        — delete + notify admins, no user warning
#
# ⚠️  Default is "block": uninspected media is NEVER silently treated as safe.
#     Set MEDIA_FALLBACK_POLICY=allow only if you accept unmoderated media.
# ─────────────────────────────────────────────────────────────────────────────

MEDIA_FALLBACK_POLICY=block

# ─────────────────────────────────────────────────────────────────────────────
# Admin bypass policy
#   true  (default) — admin violations: delete message only, no warning
#   false           — admin violations: full warning pipeline
# ─────────────────────────────────────────────────────────────────────────────

ADMIN_BYPASS_DELETE_ONLY=true

# ─────────────────────────────────────────────────────────────────────────────
# Warning & mute policy
# ─────────────────────────────────────────────────────────────────────────────

MAX_WARNINGS=3
DEFAULT_MUTE_MINUTES=1440     # 24 hours
DEDUP_TTL_SECONDS=300
MEDIA_MAX_BYTES=20971520      # 20 MB; videos larger than this are not inspected

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure
# ─────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  RENDER FREE TIER WARNING
#
# Render free web services SLEEP after 15 minutes of inactivity.
# Messages received while the service is sleeping are NOT moderated.
# For reliable production moderation:
#   • Upgrade to Render Starter ($7/mo) for always-on execution, OR
#   • Deploy to a VPS (e.g. Oracle Cloud free always-on tier)
# ─────────────────────────────────────────────────────────────────────────────
